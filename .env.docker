SERVICE_NAME=email-service
PORT=3031
HOST=0.0.0.0
ENV=PROD

# Database credentials (update for your environment)
# Use host.docker.internal for local PostgreSQL on host machine
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=rahul_db

# Worker configuration
EMAIL_WORKERS=1
PROCESSING_TIMEOUT=30
WORKER_BREAK_TIME=2

# IMAP worker configuration
IMAP_CLAIM_TIMEOUT=5
IMAP_MAX_MAILBOXES=10
IMAP_POLL_INTERVAL=30

# Webhook worker configuration
WEBHOOK_POLL_INTERVAL=5
WEBHOOK_TIMEOUT=5
WEBHOOK_MAX_ATTEMPTS=5

# Encryption (CHANGE THIS IN PRODUCTION!)
ENCRYPTION_SECRET=jXp0rlSaXNDNHuF8fUKW3qiv6DEpQ8Dag6dw8VW6Ntk=
